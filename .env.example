# Server-only environment variables (never exposed to browser)
MONGODB_URI=your_same_mongodb_atlas_connection_string
MONGODB_DB_NAME=equipmentRentalDB
BETTER_AUTH_SECRET=your_random_better_auth_secret
BETTER_AUTH_URL=http://localhost:3000
JWT_ACCESS_SECRET=your_same_jwt_secret_from_server
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Public frontend configuration keys
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key
